FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --retries 2 --timeout 30 -r requirements.txt \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app app
COPY --chown=app:app backend/ ./
USER app
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:3001/api/health/', timeout=2)"
CMD ["gunicorn", "core.wsgi:application", "--bind", "0.0.0.0:3001", "--workers", "2", "--access-logfile", "-", "--error-logfile", "-"]
