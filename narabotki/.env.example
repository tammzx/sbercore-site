# --- SberID (OIDC) ---
SBERID_CLIENT_ID=your_client_id
SBERID_CLIENT_SECRET=your_client_secret
SBERID_REDIRECT_URI=http://localhost:8000/auth/sberid/callback

# --- GigaChat API ---
GIGACHAT_CLIENT_ID=your_gigachat_client_id
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Путь к CA-bundle (НУЦ Минцифры) для прод-контура; пусто = системные CA
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=true

# --- SberBusiness API (опционально) ---
SBERBUSINESS_CLIENT_ID=
SBERBUSINESS_CLIENT_SECRET=

# --- Инфраструктура (только РФ) ---
DATABASE_URL=postgresql+asyncpg://sberone:sberone@localhost:5432/sberone
REDIS_URL=redis://localhost:6379/0

# --- Секреты ---
# Ключ для HMAC-псевдонимизации user_ref
PSEUDONYM_KEY=change_me_hmac_key
# Ключ шифрования истории (Fernet, 32 байта base64)
ENCRYPTION_KEY=change_me_fernet_key
JWT_SECRET=change_me_jwt_secret

# --- Compliance ---
DATA_RESIDENCY=RU
SESSION_TTL_SECONDS=43200
AUDIT_RETENTION_DAYS=1825
